  "resolver_version": "pack-resolver@0.1.0",
  "schema_version": "resolution-vectors.v0.1",
  "vectors": [
    {
      "evaluated_at": "2026-07-01T00:00:00Z",
      "id": "three-layer-baseline",
      "packs": [
        "fiduciaire.base@0.1.0",
        "jurisdiction.ma@0.1.0",
        "organization.demo@1.0.0"
      ],
      "why": "The milestone: three fictional layers load, conflict, and resolve to one canonical manifest. vocabulary.labels.grand_livre is contested and the organization wins it \u2014 under a control the domain layer left `open`, never by rank alone."
    },
    {
      "evaluated_at": "2026-07-01T00:00:00Z",
      "id": "three-layer-permuted",
      "packs": [
        "organization.demo@1.0.0",
        "fiduciaire.base@0.1.0",
        "jurisdiction.ma@0.1.0"
      ],
      "same_result_as": "three-layer-baseline",
      "why": "Byte-identical to three-layer-baseline except for input order. Same manifest, same hash. The list is transport; the input is a set (R7)."
    },
    {
      "evaluated_at": "2026-07-01T00:00:00Z",
      "id": "same-pack-different-source-ref",
      "packs": [
        "fiduciaire.base@0.1.0",
        "jurisdiction.ma@0.1.0",
        "jurisdiction.ma@0.1.0#mirror-copy",
        "organization.demo@1.0.0"
      ],
      "same_result_as": "three-layer-baseline",
      "why": "The same pack supplied twice from two different carriers. It deduplicates by content, and the manifest is identical to three-layer-baseline: a referent is never its carrier (R12)."
    },
    {
      "evaluated_at": "2026-07-01T00:00:00Z",
      "id": "peer-union-commutes",
      "packs": [
        "fiduciaire.base@0.1.0",
        "jurisdiction.ma@0.1.0",
        "jurisdiction.fr@0.1.0",
        "organization.demo@1.0.0"
      ],
      "why": "Two jurisdiction packs at equal rank. Their contributions are `union`, which commutes, so peers are permitted and the fold is order-free."
    },
    {
      "evaluated_at": "2026-07-01T00:00:00Z",
      "id": "derogation-valid",
      "packs": [
        "fiduciaire.base@0.1.0",
        "jurisdiction.ma@0.2.0"
      ],
      "why": "retention_years is raised 5 -> 10 under a derogation that names the path literally, cites an authority, and is in force at evaluated_at. resolution_rule is derogated_override."
    },
    {
      "evaluated_at": "2026-07-01T00:00:00Z",
      "id": "empty-packset",
      "packs": [],
      "why": "Boundary case. No packs is not an error: it resolves to an empty manifest recording that NO rules were in force. A consumer must read that as 'nothing governed here', never as 'anything permitted' \u2014 the empty manifest authorizes nothing."
    },
    {
      "evaluated_at": "2026-07-01T00:00:00Z",
      "id": "peer-conflict-replace",
      "packs": [
        "fiduciaire.base@0.1.0",
        "jurisdiction.ma@0.1.1",
        "jurisdiction.fr@0.1.1"
      ],
      "why": "Two peers, `replace` semantics, different values, nothing to distinguish them. Refusing is the correct answer; picking a winner would require an order that does not exist (R4/R7)."
    },
    {
      "evaluated_at": "2026-07-01T00:00:00Z",
      "id": "forbidden-override",
      "packs": [
        "fiduciaire.base@0.1.0",
        "organization.demo@1.1.0"
      ],
      "why": "`forbidden` is absolute and is checked BEFORE any derogation is consulted, so no authority and no rank reaches this path (R5)."
    },
    {
      "evaluated_at": "2026-07-01T00:00:00Z",
      "id": "derogation-required",
      "packs": [
        "fiduciaire.base@0.1.0",
        "jurisdiction.ma@0.3.0"
      ],
      "why": "The permission floor is requires_derogation and no derogation covers the path. Refusal, not a silent grant."
    },
    {
      "evaluated_at": "2027-06-01T00:00:00Z",
      "id": "derogation-expired",
      "packs": [
        "fiduciaire.base@0.1.0",
        "jurisdiction.ma@0.2.0"
      ],
      "why": "Identical packs to derogation-valid, different evaluated_at. Evaluation time is an input (R8): same rules, different instant, different lawful outcome."
    },
    {
      "evaluated_at": "2026-07-01T00:00:00Z",
      "id": "derogation-malformed",
      "packs": [
        "fiduciaire.base@0.1.0",
        "jurisdiction.ma@0.4.0"
      ],
      "why": "Empty derogation window. Fails closed in P4 unconditionally \u2014 even though the path it names would have been contested anyway, the malformed derogation alone refuses the resolution."
    },
    {
      "evaluated_at": "2026-07-01T00:00:00Z",
      "id": "strategy-relaxation-refused",
      "packs": [
        "fiduciaire.base@0.1.0",
        "jurisdiction.ma@0.5.0"
      ],
      "why": "override may be tightened, never loosened. A layer cannot vote itself more freedom than the layer that introduced the field granted it (R3)."
    },
    {
      "evaluated_at": "2026-07-01T00:00:00Z",
      "id": "merge-semantics-conflict",
      "packs": [
        "fiduciaire.base@0.1.0",
        "jurisdiction.ma@0.6.0"
      ],
      "why": "merge is fixed at introduction and is not overridable at any rank. Allowing a higher layer to flip union -> replace would change the MEANING of a field silently (R3)."
    },
    {
      "evaluated_at": "2026-07-01T00:00:00Z",
      "id": "undeclared-control-fails-closed",
      "packs": [
        "fiduciaire.base@0.2.0",
        "organization.demo@2.0.0"
      ],
      "why": "A leaf covered by no control declaration takes {merge: replace, override: forbidden}. An undeclared field is not an open field. This mirrors verify_hash failing closed on an unknown prefix (R3bis/D4)."
    },
    {
      "evaluated_at": "2026-07-01T00:00:00Z",
      "id": "unknown-referent-layer",
      "packs": [
        "fiduciaire.base@0.1.0",
        "regulator.ma@0.1.0"
      ],
      "why": "A fifth layer is refused in P1 rather than ranked. Note the pack is deliberately schema-invalid: the resolver must refuse it on its own, without leaning on the schema having run."
    },
    {
      "evaluated_at": "2026-07-01T00:00:00Z",
      "id": "duplicate-pack-identity",
      "packs": [
        "fiduciaire.base@0.1.0",
        "jurisdiction.ma@0.1.0",
        "jurisdiction.ma@0.2.0"
      ],
      "why": "The same pack_id at two versions in one resolution. Which version governs is undecidable, so it is refused rather than resolved by list position."
    },
    {
      "evaluated_at": "2026-07-01T00:00:00Z",
      "id": "compatibility-violation",
      "packs": [
        "fiduciaire.base@0.1.0",
        "jurisdiction.ma@0.9.0"
      ],
      "why": "A pack's own declared requirement is unmet. Checked in P2, before any value is composed."
    },
    {
      "evaluated_at": "2026-07-01T00:00:00Z",
      "id": "refusal-ordering-by-path",
      "packs": [
        "fiduciaire.base@0.1.0",
        "jurisdiction.ma@0.7.0",
        "jurisdiction.fr@0.7.0"
      ],
      "why": "Two refusals sharing one code. R9 orders them by `path`; sorting the whole refusal object canonically would order them by `detail`, which comes first alphabetically and is prose. The two orders disagree here, so this vector separates the rule from a plausible imitation of it \u2014 and because the refusal set is hashed, the disagreement is a different refusal_hash, not a cosmetic difference."
    },
    {
      "evaluated_at": "2026-07-01T00:00:00Z",
      "id": "refusal-ordering-tie-break",
      "packs": [
        "fiduciaire.base@0.1.0",
        "jurisdiction.ma@0.8.0"
      ],
      "why": "Two refusals identical in (code, path, pack_refs). The primary key cannot separate them, so an implementation without the total tie-break falls back on construction order \u2014 here, the order the author happened to type the requirements in. That is exactly the input-order dependence R9 exists to remove, hiding one level down inside a hashed structure."
    }
  ],
